# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/todo?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# Comma-separated list of allowed CORS origins (or a single origin)
CORS_ORIGIN="http://localhost:5173"

# Backend port (defaults to 3000)
PORT=3000

# Email OTP configuration — Gmail App Password (free)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"

# OTP lifetime in minutes (defaults to 10)
OTP_TTL_MINUTES=10
